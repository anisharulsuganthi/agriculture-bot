# ==========================================================
# Smart Farm / Agricultural Decision Intelligence System
# Environment template - copy to "backend/.env" and fill in real values.
# NEVER commit the real ".env" file (it is in .gitignore).
#
# Every value below is read by backend/app/config.py. Relative paths resolve
# against the PROJECT ROOT, not the current working directory.
# ==========================================================

# ---- application ----------------------------------------------------
APP_ENV=development
# Loopback by default. Use 0.0.0.0 only for a LAN demo, and then also set
# TRUST_PROXY_HEADERS=true if a reverse proxy sits in front.
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_URL=http://localhost:5500
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
# LOG_DIR=backend/logs

# ---- database -------------------------------------------------------
# Default: <project>/backend/database.db (absolute, CWD independent).
# DATABASE_PATH=C:/path/to/project/backend/database.db
DATABASE_ECHO=false
DATABASE_ENABLE_FOREIGN_KEYS=true

# ---- authentication -------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# If left empty an ephemeral per-process secret is generated: the API still
# works, but every restart invalidates issued tokens.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# The Version-1 X-User-Id header is a spoofable identity claim. Keep it false.
ALLOW_LEGACY_USER_HEADER=false
PASSWORD_MIN_LENGTH=8
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- rate limiting --------------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
REGISTER_RATE_LIMIT=20
FORGOT_RATE_LIMIT=5
RESET_RATE_LIMIT=10
NOTIFY_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=300
# X-Forwarded-For is client controlled - only trust it behind a real proxy.
TRUST_PROXY_HEADERS=false

# ---- CORS (comma separated; never use * in production) --------------
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- machine learning ----------------------------------------------
# Default: <project>/backend/models/plant_disease_model
# MODEL_DIR=backend/models/plant_disease_model
ML_DEVICE=auto
ML_TOP_K=5
ML_CONFIDENCE_FLOOR=40
ML_WARMUP_ON_STARTUP=true

# ---- uploads -------------------------------------------------------
MAX_UPLOAD_BYTES=8388608
MIN_IMAGE_DIMENSION=32
MAX_IMAGE_PIXELS=25000000

# ---- weather (OpenWeatherMap) --------------------------------------
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_TIMEOUT_SECONDS=10
# true = allow clearly labelled simulated weather when the provider is down.
# Must be false when APP_ENV=production.
ALLOW_SIMULATED_WEATHER=true

# ---- email / SMTP --------------------------------------------------
# Use a Gmail App Password, never the account password.
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
EMAIL_APP_PASSWORD=

# ---- knowledge base + RAG (Phase 4-5) ------------------------------
# Default: <project>/data/knowledge_base and <project>/data/vector_store
# KNOWLEDGE_BASE_DIR=data/knowledge_base
# VECTOR_STORE_DIR=data/vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
# LLM_PROVIDER: extractive (offline, no external calls) | openai_compatible | local
LLM_PROVIDER=extractive
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=45

# ---- legacy data ownership -----------------------------------------
# Rows created before authentication existed (user_id IS NULL) are assigned to
# this account by migration 001. Leave empty to use the lowest user id.
# Changing this after migration 001 has run has no effect - write a new
# migration instead.
LEGACY_DATA_OWNER_EMAIL=
