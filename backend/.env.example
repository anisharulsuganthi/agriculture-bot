# ==========================================================
# Smart Farm / Agricultural Decision Intelligence System
# Environment template - copy to "backend/.env" and fill in real values.
# NEVER commit the real ".env" file (it is in .gitignore).
# ==========================================================

# ---- application ----------------------------------------------------
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5500
API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ---- database -------------------------------------------------------
# Absolute path is recommended. Relative paths resolve from the backend folder.
# DATABASE_PATH=C:/path/to/project/backend/database.db
DATABASE_ECHO=false

# ---- authentication (REQUIRED) --------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Legacy X-User-Id header support. Set false once the client uses Bearer tokens.
ALLOW_LEGACY_USER_HEADER=true
PASSWORD_MIN_LENGTH=6
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# ---- rate limiting --------------------------------------------------
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10
OTP_RATE_LIMIT=5
RATE_LIMIT_WINDOW_SECONDS=300

# ---- CORS (comma separated; never use * in production) --------------
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ---- machine learning ----------------------------------------------
# MODEL_DIR=./models/plant_disease_model
ML_DEVICE=auto
ML_TOP_K=5
ML_CONFIDENCE_FLOOR=40
ML_WARMUP_ON_STARTUP=true

# ---- uploads -------------------------------------------------------
MAX_UPLOAD_BYTES=8388608
MIN_IMAGE_DIMENSION=32
MAX_IMAGE_PIXELS=25000000

# ---- weather (OpenWeatherMap) --------------------------------------
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_TIMEOUT_SECONDS=10
# true = allow clearly labelled simulated weather when the provider is down
ALLOW_SIMULATED_WEATHER=true

# ---- email / SMTP --------------------------------------------------
EMAIL_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
EMAIL_APP_PASSWORD=

# ---- knowledge base + RAG (Phase 4-5) ------------------------------
KNOWLEDGE_BASE_DIR=../data/knowledge_base
VECTOR_STORE_DIR=../data/vector_store
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_MIN_SCORE=0.25
# LLM_PROVIDER: extractive (no external calls) | openai_compatible | local
LLM_PROVIDER=extractive
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-2-latest

# ---- legacy data ownership -----------------------------------------
# Rows created before authentication existed (user_id IS NULL) are assigned to
# this account by migration 001. Leave empty to use the lowest user id.
LEGACY_DATA_OWNER_EMAIL=
