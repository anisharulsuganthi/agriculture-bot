# ---- secrets / local configuration -------------------------------------
.env
backend/.env
*.env.local
.env.*
!.env.example

# ---- python -------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- virtual environments ----------------------------------------------
venv/
.venv/
env/

# ---- runtime data -------------------------------------------------------
backend/logs/
*.log
backend/logs/*.log
backend/backups/
*.db-journal
*.db-wal
*.db-shm

# The live SQLite database holds account emails and password hashes, so it is
# NOT tracked. It is created automatically by backend/migrations on first start
# and backed up before every migration into backend/backups/.
backend/database.db
*.sqlite
*.sqlite3

# A structure-only copy may be committed for documentation purposes.
!backend/database.schema.sql

# ---- ML model weights ---------------------------------------------------
# The fine-tuned MobileNetV2 weights are ~9 MB. They are required to run the
# disease endpoint, so they stay tracked. Hugging Face download caches are not.
.cache/
huggingface/
*.safetensors.tmp

# ---- editors / OS -------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
